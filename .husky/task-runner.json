{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "format-check",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "format",
        "src/HomelabBrain/HomelabBrain.slnx",
        "--verify-no-changes",
        "--no-restore"
      ],
      "output": "always"
    }
  ]
}
