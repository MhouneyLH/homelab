          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "wg_gesucht_requests_total{status=\"Pending\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
