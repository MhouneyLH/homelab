        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10b981"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Requests per Month",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "wg_gesucht_requests_monthly",
          "instant": true,
          "legendFormat": "{{month}}",
          "refId": "A"
        }
      ],
      "options": {
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "fillOpacity": 80,
        "gradientMode": "none",
        "orientation": "auto",
        "showValue": "always",
        "stacking": "none",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Status Distribution",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "wg_gesucht_requests_total{status=\"Pending\"}",
          "legendFormat": "Pending",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "wg_gesucht_requests_total{status=\"Accepted\"}",
          "legendFormat": "Accepted",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "wg_gesucht_requests_total{status=\"Declined\"}",
          "legendFormat": "Declined",
          "instant": true,
          "refId": "C"
        }
      ],
      "options": {
        "displayLabels": [
          "name",
          "value"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "pie",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f59e0b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Accepted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#10b981"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Declined"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ef4444"
                }
              }
            ]
          }
        ]
      }
